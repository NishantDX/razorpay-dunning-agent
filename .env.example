# Copy this file to .env and fill in real values. .env is gitignored.

# ---- LLM provider ----
# Gemini API key from https://aistudio.google.com  (free, no card needed)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- Razorpay (Test Mode) ----
# Dashboard -> switch to "Test Mode" -> Settings -> API Keys -> Generate Test Key
# Keys look like rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here

# ---- Run settings ----
# Seed for the synthetic data generator. Keep fixed for reproducible demos.
RANDOM_SEED=42
# Number of at-risk cases to generate.
BATCH_SIZE=300
# Dev convenience: 1 = skip real Razorpay calls, use a local simulator instead.
# Default 0 = every Razorpay call is a real test-mode API call.
RAZORPAY_DRY_RUN=0
