# Copy this file to .env and fill in real values. .env is gitignored.

# ---- LLM provider ----
# Gemini API key from https://aistudio.google.com  (free, no card needed)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- Razorpay (Test Mode) ----
# Dashboard -> switch to "Test Mode" -> Settings -> API Keys -> Generate Test Key
# Keys look like rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here
# Fail safe: real test-mode API calls happen ONLY when this is 1 (and both keys
# are set and RAZORPAY_DRY_RUN=0). Anything else uses the local simulator.
RAZORPAY_LIVE=0
# Force the local simulator even if keys/RAZORPAY_LIVE are set.
RAZORPAY_DRY_RUN=0

# ---- Secrets for integrity checks ----
# Signs the replayed webhook feed (verified on the way in) and the audit
# manifest. Dev defaults exist so everything runs with no setup; override here.
WEBHOOK_SECRET=change-me-webhook-secret
AUDIT_SECRET=change-me-audit-secret

# ---- Run settings ----
# Seed for the synthetic data generator. Keep fixed for reproducible demos.
RANDOM_SEED=42
# Number of at-risk cases to generate.
BATCH_SIZE=300
